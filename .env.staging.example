# Staging / production-like (Arc Testnet)
NODE_ENV=production
DATABASE_URL="postgresql://USER:PASS@HOST:5432/AGFusion_staging?sslmode=require"

NEXT_PUBLIC_EXECUTION_MODE=live
NEXT_PUBLIC_ALLOW_DEMO=false

NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_APP_URL=https://your-staging.vercel.app
NEXT_PUBLIC_APP_DOMAIN=your-staging.vercel.app
NEXT_PUBLIC_SIWE_CHAIN_ID=5042002

# Sign-in nonce HMAC secret — set a long random string (openssl rand -hex 32)
AUTH_SECRET=

# Prefer BazaarLink (sk-bl-...); never commit real keys
BAZAARLINK_API_KEY=
# BAZAARLINK_MODEL=openai/gpt-4.1
# XAI_API_KEY=
KIT_KEY=

AGENT_RATE_MAX=20
AGENT_RATE_EXECUTE_MAX=8
MAX_TRANSFER_AMOUNT=1000
