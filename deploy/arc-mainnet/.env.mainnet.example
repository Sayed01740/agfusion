# Copy these values into a NEW Vercel Production environment only after
# reviewing the deployment plan. Do not replace the working Testnet variables.
# Never commit real API keys, private keys, auth secrets, or database credentials.

NEXT_PUBLIC_ARC_NETWORK=mainnet
NEXT_PUBLIC_ARC_CHAIN_ID=5042
NEXT_PUBLIC_ARC_CHAIN_HEX=0x13b2
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_WS_URL=wss://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.arc.io
NEXT_PUBLIC_SIWE_CHAIN_ID=5042
# Leave blank until each reviewed contract has actually been deployed and verified.
NEXT_PUBLIC_AGFUSION_ESCROW_MAINNET_ADDRESS=
NEXT_PUBLIC_AGFUSION_DISPERSE_MAINNET_ADDRESS=
NEXT_PUBLIC_AGFUSION_REGISTRY_MAINNET_ADDRESS=
NEXT_PUBLIC_APP_URL=https://REPLACE_WITH_APPROVED_PRODUCTION_DOMAIN
NEXT_PUBLIC_APP_DOMAIN=REPLACE_WITH_APPROVED_PRODUCTION_DOMAIN

# Set through Vercel Secret/Sensitive environment variable UI, never commit:
AUTH_SECRET=
DATABASE_URL=
CIRCLE_API_KEY=
BAZAARLINK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HCNSEC_API_KEY=
KIT_KEY=

# Provider-specific browser keys must only be NEXT_PUBLIC_* if the provider
# explicitly documents them as safe for public browser use.
NEXT_PUBLIC_CIRCLE_APP_ID=
NEXT_PUBLIC_KIT_KEY=

# Keep policy fail-closed in production. Confirm application semantics before setting.
AGENT_POLICY_FAIL_CLOSED=true
MAX_TRANSFER_AMOUNT=100
AGENT_RATE_MAX=20
AGENT_RATE_EXECUTE_MAX=5
