# AGFusion FINAL — live only
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@host:5432/agfusion?sslmode=require"

NEXT_PUBLIC_EXECUTION_MODE=live
NEXT_PUBLIC_ALLOW_DEMO=false
NEXT_PUBLIC_DEMO_MODE=false

NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_APP_DOMAIN=your-domain.vercel.app
NEXT_PUBLIC_SIWE_CHAIN_ID=5042002

# Sign-in nonce HMAC secret — set a long random string (openssl rand -hex 32).
# Without it the app falls back to weaker dev secrets.
AUTH_SECRET=

# --- CIRCLE WEB3 SERVICES (Programmable Wallets) ---
# Required for Email Login feature
CIRCLE_API_KEY="YOUR_API_KEY_FROM_CONSOLE"
NEXT_PUBLIC_CIRCLE_APP_ID="YOUR_APP_ID"

# ZeroDev project id (Auto-Agent — optional)
# NEXT_PUBLIC_ZERODEV_PROJECT_ID=

# Optional LLM (server-only — never NEXT_PUBLIC_*)
#
# === HCNSEC (OpenAI-compatible) — primary ===
# Site/API: https://api.hcnsec.cn/
# HCNSEC_API_KEY=your-key-from-provider
# HCNSEC_BASE_URL=https://api.hcnsec.cn
# HCNSEC_MODEL=gpt-4o-mini
# (aliases also work):
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.hcnsec.cn
# OPENAI_MODEL=gpt-4o-mini
#
# === Official Anthropic only (key must start with sk-ant-) ===
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
#
# Fallback BazaarLink:
# BAZAARLINK_API_KEY=sk-bl-...
# BAZAARLINK_MODEL=google/gemini-2.5-flash
#
# Fallback xAI:
# XAI_API_KEY=
# XAI_MODEL=grok-4.5

AGENT_RATE_MAX=40
AGENT_RATE_EXECUTE_MAX=15
MAX_TRANSFER_AMOUNT=10000

# Circle App Kit key (live swap / bridge on Arc Testnet)
# Free: https://console.circle.com → Keys → Kit keys
# KIT_KEY=
# NEXT_PUBLIC_KIT_KEY=
